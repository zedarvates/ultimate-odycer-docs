{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/npc-benchmark-v1.schema.json",
  "title": "NPC benchmark result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "recorded_at",
    "hardware",
    "software",
    "workload",
    "measurements",
    "capacity",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "npc-benchmark-v1"},
    "status": {
      "enum": ["observed", "estimated", "decision", "unavailable"]
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "cpu", "ram_bytes", "storage", "cooling"],
      "properties": {
        "device": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "ram_bytes": {"$ref": "#/$defs/nonnegativeNumberOrUnavailable"},
        "storage": {"type": "string", "minLength": 1},
        "cooling": {"type": "string", "minLength": 1}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "revision", "model", "quantization", "runtime"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reply_seconds",
        "npc_interval_seconds",
        "utilization",
        "streams",
        "context_tokens",
        "max_output_tokens",
        "stt",
        "tts"
      ],
      "properties": {
        "reply_seconds": {"type": "number", "exclusiveMinimum": 0},
        "npc_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "utilization": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "streams": {"type": "integer", "minimum": 1},
        "context_tokens": {"$ref": "#/$defs/nonnegativeNumberOrUnavailable"},
        "max_output_tokens": {"$ref": "#/$defs/nonnegativeNumberOrUnavailable"},
        "stt": {"enum": ["included", "excluded", "unavailable"]},
        "tts": {"enum": ["included", "excluded", "unavailable"]}
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "p50_seconds", "p95_seconds", "error_count"],
      "properties": {
        "sample_count": {"$ref": "#/$defs/nonnegativeIntegerOrUnavailable"},
        "p50_seconds": {"$ref": "#/$defs/nonnegativeNumberOrUnavailable"},
        "p95_seconds": {"$ref": "#/$defs/nonnegativeNumberOrUnavailable"},
        "error_count": {"$ref": "#/$defs/nonnegativeIntegerOrUnavailable"}
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_replies_per_minute",
        "supported_active_npcs",
        "queue_policy"
      ],
      "properties": {
        "planned_replies_per_minute": {"type": "number", "minimum": 0},
        "supported_active_npcs": {"type": "integer", "minimum": 0},
        "queue_policy": {"const": "serialize_per_stream"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "nonnegativeNumberOrUnavailable": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"const": "unavailable"}
      ]
    },
    "nonnegativeIntegerOrUnavailable": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"const": "unavailable"}
      ]
    }
  }
}
