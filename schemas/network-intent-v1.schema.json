{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/network-intent-v1.schema.json",
  "title": "Public Ultimate Odycer network intent version 1",
  "description": "Documentation fixture for client-to-server intents. Not a published opcode map, binary layout, or live protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "direction",
    "family",
    "intent",
    "actor_id",
    "client_seq",
    "transport",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "network-intent-v1"
    },
    "status": {
      "enum": [
        "observed",
        "estimated",
        "decision",
        "unavailable"
      ]
    },
    "direction": {
      "const": "client_to_server"
    },
    "family": {
      "enum": [
        "session",
        "move",
        "interact",
        "combat",
        "talk",
        "inventory",
        "craft",
        "economy",
        "sync"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(player|npc|object)_demo_[a-z0-9_]+$"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(player|npc|object)_demo_[a-z0-9_]+$"
    },
    "client_seq": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9:_-]*$"
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tls"
      ],
      "properties": {
        "kind": {
          "enum": [
            "documentation_fixture"
          ]
        },
        "tls": {
          "enum": [
            "required_outside_loopback",
            "unavailable"
          ]
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "choice_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "emote_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
